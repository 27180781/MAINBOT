# ---- LiveKit (Cloud project or self-hosted server) ----
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Claude ----
ANTHROPIC_API_KEY=sk-ant-...
RT_MODEL=claude-sonnet-5          # fast model for realtime; claude-haiku-4-5 is faster and cheaper, claude-opus-5 smarter but slower
RT_EFFORT=low                     # low | medium | high (latency vs. depth)
RT_MAX_TOKENS=1024
RT_MAX_TOOL_STEPS=6

# ---- Speech ----
SONIOX_API_KEY=
SONIOX_STT_URL=wss://stt-rt.soniox.com/transcribe-websocket   # use the EU endpoint from the Soniox console if you need EU residency
SONIOX_STT_MODEL=stt-rt-v5
STT_LANGUAGE_HINTS=he,en
STT_CONTEXT=חוויה בקליק, קליקרים, בת מצווה, סמינר, מקדמה, סאמיט, ימות המשיח   # words the transcriber should expect
TTS_PROVIDER=elevenlabs           # elevenlabs | soniox
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=              # a multilingual voice from your ElevenLabs voice library
ELEVENLABS_MODEL=eleven_flash_v2_5
TTS_LANGUAGE=he
SONIOX_TTS_VOICE=Maya
RT_NOISE_CANCELLATION=auto        # auto (BVC on LiveKit Cloud, telephony variant for SIP) | off

# ---- Turn taking ----
RT_TURN_DETECTION=stt             # stt = Soniox endpoint detection (recommended for Hebrew) | vad
RT_MIN_ENDPOINTING_DELAY=0.4
RT_MAX_ENDPOINTING_DELAY=2.5
RT_MIN_INTERRUPTION_DURATION=0.5
RT_MIN_INTERRUPTION_WORDS=0
RT_PREEMPTIVE_GENERATION=true

# ---- The Node bot (shares MCP credentials, rules and instructions) ----
MAINBOT_URL=https://mainbot.caprover.clicker.co.il
INTERNAL_API_KEY=                 # same value as INTERNAL_API_KEY in the Node bot

# ---- Safety ----
ALLOWED_CALLER_PHONES=            # empty = take the list from the Node bot; SIP callers not on it are refused
CONFIRM_WRITE_ACTIONS=true
BLOCKED_TOOLS=

# ---- Test page / token server ----
WEB_ACCESS_KEY=                   # at least 8 chars; the page asks for it
WEB_PORT=8080

# ---- Logs ----
RT_DATA_DIR=./data                # latency + transcript JSONL per session under data/realtime/<date>/
RT_GREETING=שלום, כאן העוזר החכם. במה אוכל לעזור?
TIMEZONE=Asia/Jerusalem
