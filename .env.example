# ---- Claude ----
ANTHROPIC_API_KEY=sk-ant-...
# Runtime defaults (all editable later from /admin):
BOT_MODEL=claude-opus-5
BOT_EFFORT=medium
BOT_MAX_TOKENS=4096
BOT_FALLBACKS=default          # default | off  (server-side refusal fallback)
TOOL_SEARCH=true                  # load MCP tools on demand instead of all at once

# ---- HTTP server ----
PORT=3000
HOST=0.0.0.0
# Public HTTPS address of this server (needed for OAuth logins from /admin and for audio files)
PUBLIC_BASE_URL=https://bot.example.com
# Secret path segment for the PBX webhook: https://bot.example.com/pbx/technoline/<WEBHOOK_SECRET>
WEBHOOK_SECRET=change-me-to-a-long-random-string
TRUST_PROXY=true

# ---- Admin UI (/admin) ----
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# ---- Callers ----
# Comma separated phones allowed to use the assistant (use * to allow everyone - not recommended)
ALLOWED_CALLER_PHONES=0533173438
# Optional numeric PIN asked at the start of every call
BOT_PIN=
GREETING=שלום, כאן העוזר החכם. אחרי הצפצוף אמרו במה אוכל לעזור.

# ---- Timing ----
PBX_LONG_POLL_MS=20000            # keep below the PBX ~30s response timeout
AGENT_TIMEOUT_MS=180000
TOOL_TIMEOUT_MS=60000
STT_MAX_SECONDS=10                # PBX maximum is 10

# ---- Files ----
DATA_DIR=./data
MCP_CONFIG_PATH=./config/mcp-servers.json
MCP_AUTH_DIR=./.mcp-auth
INSTRUCTIONS_PATH=./config/instructions.md
TIMEZONE=Asia/Jerusalem
LOG_LEVEL=info

# ---- Tokens for MCP servers that use bearer auth (referenced from config/mcp-servers.json) ----
GITHUB_TOKEN=
