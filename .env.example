# ---- Claude ----
ANTHROPIC_API_KEY=sk-ant-...
# Runtime defaults (all editable later from /admin):
BOT_MODEL=claude-opus-5
BOT_EFFORT=medium
BOT_MAX_TOKENS=8192               # shared between thinking and the answer
BOT_FALLBACKS=default          # default | off  (server-side refusal fallback)
TOOL_SEARCH=true                  # load MCP tools on demand instead of all at once
CONFIRM_WRITE_ACTIONS=true        # ask the caller to confirm before any tool that writes, sends or deletes
TTS_VOICE=                        # PBX TTS voice for prompts (empty = PBX default)

# ---- HTTP server ----
PORT=3000
HOST=0.0.0.0
# Public HTTPS address of this server (needed for OAuth logins from /admin and for audio files)
PUBLIC_BASE_URL=https://bot.example.com
# Secret path segment for the PBX webhook: https://bot.example.com/pbx/technoline/<WEBHOOK_SECRET>
WEBHOOK_SECRET=change-me-to-a-long-random-string
TRUST_PROXY=true

# ---- Admin UI (/admin) ----
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# ---- Callers ----
# Comma separated phones allowed to use the assistant (use * to allow everyone - not recommended)
ALLOWED_CALLER_PHONES=0533173438
# Optional numeric PIN asked at the start of every call
BOT_PIN=
GREETING=שלום, כאן העוזר החכם. אחרי הצפצוף אמרו במה אוכל לעזור.

# ---- Timing ----
PBX_LONG_POLL_MS=20000            # keep below the PBX ~30s response timeout (clamped to 1000-25000)
PBX_FIRST_POLL_MS=6000            # wait on the request that carries the utterance before the first filler
AGENT_TIMEOUT_MS=180000
TOOL_TIMEOUT_MS=60000
STT_MAX_SECONDS=10                # PBX maximum is 10
SESSION_TTL_MS=1800000            # drop idle call sessions after 30 minutes
MAX_TOOL_RESULT_CHARS=20000       # truncate long MCP tool results before they reach Claude

# ---- Files ----
DATA_DIR=./data
MCP_CONFIG_PATH=./config/mcp-servers.json
MCP_AUTH_DIR=./.mcp-auth
INSTRUCTIONS_PATH=./config/instructions.md
TIMEZONE=Asia/Jerusalem
LOG_LEVEL=info
LOG_PRETTY=0                      # 1 = human-readable logs even when NODE_ENV=production
# Local callback port used by `npm run mcp:login -- <server>` (OAuth from the terminal)
MCP_OAUTH_CALLBACK_PORT=8765

# ---- Chat API for the CRM / other systems (docs/CRM-INTEGRATION.md) ----
# Bearer key for POST /api/v1/chat (at least 16 chars; empty = API disabled)
CHAT_API_KEY=
# Browser origins allowed to call the chat API directly (leave empty when a backend calls it)
CHAT_CORS_ORIGINS=
CHAT_SESSION_TTL_MS=7200000       # forget idle chat sessions after 2 hours

# ---- Tokens for MCP servers that use bearer auth (referenced from config/mcp-servers.json) ----
GITHUB_TOKEN=
